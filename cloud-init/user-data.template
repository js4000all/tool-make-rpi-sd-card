#cloud-config

hostname: __HOSTNAME__
manage_etc_hosts: true

locale: ja_JP.UTF-8
timezone: Asia/Tokyo

users:
  - name: pi
    groups:
      - sudo
    shell: /bin/bash
    lock_passwd: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI...your pubkey...

ssh_pwauth: false
disable_root: true
